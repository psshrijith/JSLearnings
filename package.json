{
  "name": "jslearnings",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint '**/*.{js,jsx}' --ignore-pattern node_modules",
    "lint:fix": "eslint '**/*.{js,jsx}' --ignore-pattern node_modules --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "website:preview": "npm --prefix website run preview"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.0.0",
    "prettier": "^3.9.6"
  }
}
